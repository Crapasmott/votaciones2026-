# Copia este archivo a server/.env y ajusta los valores para tu despliegue.

# Puerto donde escucha el backend
PORT=3001

# Secreto para firmar los tokens JWT de administrador.
# IMPORTANTE: en producción usa un valor largo y aleatorio, distinto al de ejemplo.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Credenciales del admin que se crea automáticamente la primera vez que
# arranca el servidor (solo si la tabla admins está vacía).
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar123

# Proveedor de envío de SMS para el código OTP.
#   demo  -> no envía SMS real, el código se devuelve en la respuesta de la
#            API (útil para pruebas). Es el valor por defecto.
#   claro -> envía por la API de Claro Empresas (hay que completar
#            server/sms.js con las credenciales reales antes de usar esto).
SMS_PROVIDER=demo

# Solo si SMS_PROVIDER=claro:
# CLARO_API_URL=
# CLARO_API_TOKEN=

# Ruta del archivo de base de datos SQLite (opcional, por defecto
# server/votacion.db)
# DB_PATH=./votacion.db
